# =============================================================================
# UCON Movie Platform — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=ucon
DB_PASSWORD=ucon_secret_change_me
DB_NAME=ucon_db

# JWT secret (change in production)
JWT_SECRET=ucon_jwt_super_secret_change_in_production

# Backend server port
PORT=8080

# Path to static files (videos + ads) inside the container
STATIC_DIR=/app/static

# Frontend → Backend URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
